# Wavely environment template — copy to `.env` locally, NEVER commit `.env`.
#
# Stage 1.2 load strategy: the app reads compile-time env values. Run:
#   flutter run  --dart-define-from-file=.env
#   flutter test --dart-define-from-file=.env
# (Plain KEY=VALUE lines — this template works as-is after copying.)
# Omitting the flag is fine: every key degrades gracefully and the local
# player core keeps working.
# The app itself MUST remain fully functional with only:
#   SUPABASE_* (auth/sync) + one AI provider key.
# Every key below is OPTIONAL.

# ── GitHub (owner machine / CI only — NEVER ship, never echo) ──
# Fine-grained PAT: only repo Music_Wavely, Contents:R/W, PRs:R/W, Metadata:R
GITHUB_TOKEN=
GITHUB_USERNAME=Dani-Devlop
GITHUB_REPO=Music_Wavely

# ── Supabase (auth / sync — later stage; empty is fine for now) ─
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram bot (later stage) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=

# ── AI providers (chat feature — later stage) ──────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Metadata-only official APIs (no playback, no download) ─────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DEEZER_APP_ID=
DEEZER_APP_SECRET=
LASTFM_API_KEY=

# ── Legal free-catalog sources (later stage) ───────────────────
JAMENDO_CLIENT_ID=

# ── Sentry (crash-only, no PII) ────────────────────────────────
SENTRY_DSN=
